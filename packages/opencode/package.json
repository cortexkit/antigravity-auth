{
  "name": "@cortexkit/opencode-antigravity-auth",
  "version": "2.2.1",
  "description": "Google Antigravity OAuth auth plugin for OpenCode - access Gemini 3 and Claude 4.6 using Google credentials",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "CortexKit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/antigravity-auth.git",
    "directory": "packages/opencode"
  },
  "homepage": "https://github.com/cortexkit/antigravity-auth#readme",
  "bugs": {
    "url": "https://github.com/cortexkit/antigravity-auth/issues"
  },
  "keywords": [
    "opencode",
    "google",
    "antigravity",
    "gemini",
    "oauth",
    "plugin",
    "auth",
    "claude"
  ],
  "engines": {
    "node": ">=20.0.0",
    "opencode": ">=1.17.13 <2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./src/tui/entry.mjs",
      "types": "./dist/src/tui.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/tui.tsx",
    "src/tui/entry.mjs",
    "src/tui/command-dialogs.tsx",
    "src/tui/file-logger.ts",
    "src/tui-preferences.ts",
    "src/sidebar-state.ts",
    "src/rpc/rpc-client.ts",
    "src/rpc/rpc-dir.ts",
    "src/rpc/port-file.ts",
    "src/rpc/protocol.ts",
    "src/plugin/command-data.ts",
    "src/common-auth-embedded/",
    "src/tui-raw/",
    "src/tui-compiled/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "embed:check": "bun scripts/build-tui.ts --check",
    "build": "bun run embed:check && bun scripts/build-tui.ts --library",
    "build:tui": "bun run embed:check && bun scripts/build-tui.ts",
    "build:schema": "bunx tsx script/build-schema.ts",
    "smoke:tui": "bun run embed:check && bun scripts/smoke-tui-pack-install.ts",
    "typecheck": "bun run embed:check && bun scripts/build-tui.ts --types && tsc --noEmit",
    "test": "bun run embed:check && bun test --isolate ./src ./scripts/build-tui.test.ts",
    "lint": "bun run embed:check && biome lint . --error-on-warnings",
    "format": "bun run embed:check && biome format --write .",
    "format:check": "bun run embed:check && biome format .",
    "prepack": "bun run embed:check && bun run build",
    "prepublishOnly": "bun run embed:check && bun run build",
    "test:e2e:models": "bunx tsx script/test-models.ts",
    "test:e2e:regression": "bunx tsx script/test-regression.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0",
    "typescript": "^5 || ^6"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "zod-to-json-schema": "^3.25.1",
    "@opencode-ai/sdk": "1.17.13"
  },
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "2.2.1",
    "jsonc-parser": "^3.3.1",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.0.0"
  },
  "bin": {
    "antigravity-auth": "./dist/cli.js"
  }
}
